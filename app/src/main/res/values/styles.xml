<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Typography -->
    <style name="TextAppearance.Egob.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Egob.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.Egob.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Egob.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Egob.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.Egob.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.Egob.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="TextAppearance.Egob.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="TextAppearance.Egob.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Egob.FieldLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/outline</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.Egob.FieldValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Surfaces -->
    <style name="Widget.Egob.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Egob.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/surface_container</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Egob.Card.Tinted">
        <item name="cardBackgroundColor">@color/surface_container_low</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Egob.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="iconPadding">8dp</item>
        <item name="rippleColor">@color/secondary_container</item>
    </style>
    <style name="Widget.Egob.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/primary_container</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary_container</item>
        <item name="iconTint">@color/primary_container</item>
        <item name="iconPadding">8dp</item>
        <item name="backgroundTint">@color/surface_container_lowest</item>
    </style>
    <style name="Widget.Egob.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="iconTint">@color/secondary</item>
        <item name="iconPadding">6dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
    <style name="Widget.Egob.Button.Small" parent="Widget.Egob.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- Form fields -->
    <style name="Widget.Egob.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/surface_container_low</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="startIconTint">@color/on_surface_variant</item>
        <item name="endIconTint">@color/secondary</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="errorTextColor">@color/error</item>
    </style>

    <!-- Chips -->
    <style name="Widget.Egob.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="chipBackgroundColor">@color/surface_container</item>
        <item name="chipStrokeColor">@color/surface_container</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">26dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipIconSize">14dp</item>
        <item name="android:clickable">false</item>
        <item name="android:checkable">false</item>
    </style>
    <style name="Widget.Egob.Chip.Success">
        <item name="android:textColor">@color/success</item>
        <item name="chipBackgroundColor">#FFECFDF5</item>
        <item name="chipIconTint">@color/success</item>
    </style>
    <style name="Widget.Egob.Chip.Warning">
        <item name="android:textColor">@color/warning</item>
        <item name="chipBackgroundColor">#FFFFF7E6</item>
        <item name="chipIconTint">@color/warning</item>
    </style>
    <style name="Widget.Egob.Chip.Info">
        <item name="android:textColor">@color/secondary</item>
        <item name="chipBackgroundColor">@color/surface_container_low</item>
        <item name="chipIconTint">@color/secondary</item>
    </style>
    <style name="Widget.Egob.Chip.Error">
        <item name="android:textColor">@color/error</item>
        <item name="chipBackgroundColor">@color/error_container</item>
        <item name="chipIconTint">@color/error</item>
    </style>
    <style name="Widget.Egob.Chip.Tertiary">
        <item name="android:textColor">@color/on_tertiary_fixed_variant</item>
        <item name="chipBackgroundColor">@color/tertiary_fixed</item>
        <item name="chipIconTint">@color/on_tertiary_fixed_variant</item>
    </style>
    <style name="Widget.Egob.Chip.Dark" parent="Widget.Egob.Chip">
        <item name="android:textColor">@color/tertiary_fixed</item>
        <item name="chipBackgroundColor">#33002B1B</item>
        <item name="chipIconTint">@color/tertiary_fixed</item>
    </style>
    <style name="Widget.Egob.Chip.Secondary">
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="chipBackgroundColor">@color/secondary_container</item>
        <item name="chipIconTint">@color/on_secondary_container</item>
    </style>
    <style name="Widget.Egob.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="chipIconTint">@color/chip_filter_text</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.Egob.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_container_lowest</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemIconSize">23dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Egob.BottomNavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Egob.BottomNavInactive</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Egob.BottomNavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>
    <style name="TextAppearance.Egob.BottomNavActive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Egob.BottomNavInactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Egob.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/surface_container</item>
    </style>

    <!-- Misc -->
    <style name="Widget.Egob.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Widget.Egob.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Egob.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Egob.BodySmall</item>
        <item name="navigationIconTint">@color/primary</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
