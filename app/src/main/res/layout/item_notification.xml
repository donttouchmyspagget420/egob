<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notification_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_soft"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_campaign"
                app:tint="@color/secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notification_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="Acción urgente" />

                <TextView
                    android:id="@+id/notification_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="9sp"
                    tools:text="Hace 10 min" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_dismiss_notification"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/outline"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Recordatorio: plazo de declaración de impuestos" />

        <TextView
            android:id="@+id/notification_body"
            style="@style/TextAppearance.Egob.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:text="El periodo obligatorio de declaración cierra en 14 días." />

        <LinearLayout
            android:id="@+id/notification_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/notification_chip_primary"
                style="@style/Widget.Egob.Chip.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="Seguridad aprobada" />

            <com.google.android.material.chip.Chip
                android:id="@+id/notification_chip_secondary"
                style="@style/Widget.Egob.Chip.Success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ensureMinTouchTargetSize="false"
                tools:text="Paso 3 de 4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/notification_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Revisar y declarar" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@string/action_details"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/notification_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_variant"
                android:textSize="9sp"
                tools:text="IP 194.22.x" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
