<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/req_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_soft"
                android:contentDescription="@string/requests_title"
                android:padding="10dp"
                android:src="@drawable/ic_documents"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/req_ref"
                    style="@style/TextAppearance.Egob.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="#REQ-88319" />

                <TextView
                    android:id="@+id/req_date"
                    style="@style/TextAppearance.Egob.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    tools:text="Enviada el 29 oct" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/req_status"
                style="@style/Widget.Egob.Chip.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                app:ensureMinTouchTargetSize="false"
                tools:text="En proceso" />
        </LinearLayout>

        <TextView
            android:id="@+id/req_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Renovación estándar de pasaporte" />

        <LinearLayout
            android:id="@+id/req_note_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_note"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/req_note_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/requests_officer_note"
                android:textColor="@color/secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/req_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface"
                android:textSize="11sp"
                android:textStyle="italic"
                tools:text="Biometría coincidente con el registro civil." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/req_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Paso 3 de 4: Verificación y control de seguridad" />

            <TextView
                android:id="@+id/req_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="75%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/req_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progressBackgroundTint="@color/surface_container_high"
            android:progressTint="@color/secondary"
            tools:progress="75" />

        <LinearLayout
            android:id="@+id/req_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/req_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/requests_action_details"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/action_details"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/req_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_container_low" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Egob.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/requests_detail_service" />

                <TextView
                    android:id="@+id/req_detail_service"
                    style="@style/TextAppearance.Egob.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="end"
                    tools:text="Renovación de pasaporte" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Egob.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/requests_detail_delivery" />

                <TextView
                    android:id="@+id/req_detail_delivery"
                    style="@style/TextAppearance.Egob.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="end"
                    tools:text="Mensajería segura" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Egob.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/requests_detail_fee" />

                <TextView
                    android:id="@+id/req_detail_fee"
                    style="@style/TextAppearance.Egob.FieldValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="$45.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Egob.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/requests_detail_officer" />

                <TextView
                    android:id="@+id/req_detail_officer"
                    style="@style/TextAppearance.Egob.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="end"
                    tools:text="Agente #108" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Egob.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/requests_detail_attachments" />

            <TextView
                android:id="@+id/req_detail_attachments"
                style="@style/TextAppearance.Egob.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Comprobante_residencia.pdf" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
