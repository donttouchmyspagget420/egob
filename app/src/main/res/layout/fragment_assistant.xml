<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    tools:context=".ui.AssistantFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Egob.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitle="@string/assistant_bot"
        app:title="@string/assistant_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_high"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="7dp"
        android:paddingEnd="16dp"
        android:paddingBottom="7dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot_success" />

        <TextView
            style="@style/TextAppearance.Egob.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/assistant_live"
            android:textColor="@color/on_surface"
            android:textSize="9sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <!-- Consultas rápidas -->
            <TextView
                style="@style/TextAppearance.Egob.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="36dp"
                android:text="@string/assistant_quick_title"
                android:textAllCaps="true" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="36dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/quick_prompts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prompt_passport"
                        style="@style/Widget.Egob.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:checkable="false"
                        android:text="@string/assistant_prompt_passport" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prompt_tax"
                        style="@style/Widget.Egob.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:checkable="false"
                        android:text="@string/assistant_prompt_tax" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prompt_dmv"
                        style="@style/Widget.Egob.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:checkable="false"
                        android:text="@string/assistant_prompt_dmv" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prompt_address"
                        style="@style/Widget.Egob.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="false"
                        android:text="@string/assistant_prompt_address" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/chat_disclaimer"
                style="@style/TextAppearance.Egob.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/assistant_disclaimer"
                android:textColor="@color/outline"
                android:textSize="9sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de entrada -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_lowest"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/assistant_attach"
            android:padding="9dp"
            android:src="@drawable/ic_attach"
            app:tint="@color/on_surface_variant" />

        <EditText
            android:id="@+id/input_message"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_plain"
            android:hint="@string/assistant_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/outline"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/assistant_mic"
            android:padding="9dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/on_surface_variant" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_primary"
            android:contentDescription="@string/assistant_send"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="@color/on_primary" />
    </LinearLayout>
</LinearLayout>
