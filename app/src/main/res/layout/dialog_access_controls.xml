<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/text_access_dialog_summary"
        style="@style/TextAppearance.Egob.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/on_surface_variant" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_access_qr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/admin_access_qr"
        android:textColor="@color/on_surface" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_access_biometric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/admin_access_biometric"
        android:textColor="@color/on_surface" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_access_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/admin_access_key"
        android:textColor="@color/on_surface" />
</LinearLayout>
