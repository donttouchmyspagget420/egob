<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    tools:context=".ui.LoginFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Encabezado institucional -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_emblem_outer">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_emblem_inner"
                    android:contentDescription="@string/app_official"
                    android:padding="14dp"
                    android:src="@drawable/ic_account_balance"
                    app:tint="@color/on_primary" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_dot_success"
                    android:contentDescription="@string/status_verified"
                    android:padding="3dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/on_tertiary_fixed" />
            </FrameLayout>

            <TextView
                style="@style/TextAppearance.Egob.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/login_network"
                android:textAllCaps="true"
                android:textColor="@color/secondary" />

            <TextView
                style="@style/TextAppearance.Egob.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/login_title" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checkable="false"
                android:clickable="false"
                android:text="@string/login_secured"
                app:chipBackgroundColor="@color/surface_container_low"
                app:chipIcon="@drawable/ic_shield"
                app:chipIconTint="@color/secondary"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false" />
        </LinearLayout>

        <!-- Tarjeta de acceso -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Egob.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_group"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_national"
                        style="@style/Widget.Egob.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/surface_container_lowest"
                        android:elevation="1dp"
                        android:text="@string/login_tab_national"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:cornerRadius="9dp"
                        app:icon="@drawable/ic_documents"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_passkey"
                        style="@style/Widget.Egob.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/transparent"
                        android:text="@string/login_tab_passkey"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:cornerRadius="9dp"
                        app:icon="@drawable/ic_key"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="@color/on_surface_variant" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Egob.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/login_nin_label"
                    android:textAllCaps="false"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Egob.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/login_nin_placeholder"
                    app:startIconDrawable="@drawable/ic_fingerprint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_nin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.Egob.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/login_passcode_label"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/login_forgot"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Egob.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/login_passcode_placeholder"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_passcode"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_trust_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_trust_device"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Egob.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_trust_device_detail" />
                    </LinearLayout>

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Egob.Chip.Info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_level"
                        app:chipIcon="@drawable/ic_security"
                        app:ensureMinTouchTargetSize="false" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_authenticate"
                    style="@style/Widget.Egob.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/login_authenticate"
                    app:icon="@drawable/ic_lock"
                    app:iconGravity="textStart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/surface_container" />

                    <TextView
                        style="@style/TextAppearance.Egob.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:text="@string/login_instant_access"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/surface_container" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_biometric"
                    style="@style/Widget.Egob.Card.Tinted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/surface_container"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_primary"
                            android:contentDescription="@string/login_fast_biometrics"
                            android:padding="11dp"
                            android:src="@drawable/ic_contactless"
                            app:tint="@color/on_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/login_fast_biometrics"
                                    android:textColor="@color/primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_dot_success" />
                            </LinearLayout>

                            <TextView
                                style="@style/TextAppearance.Egob.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/login_fast_biometrics_detail" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/action_view_all"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/on_surface_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/link_lost_access"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="@string/login_lost_access"
                    android:textColor="@color/secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_support"
                    app:drawableTint="@color/secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Egob.Card.Tinted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_container_high">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/login_security_notice"
                    android:src="@drawable/ic_account_balance"
                    app:tint="@color/secondary" />

                <TextView
                    style="@style/TextAppearance.Egob.BodySmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/login_security_notice" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/login_first_time"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            style="@style/Widget.Egob.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/login_register"
            app:icon="@drawable/ic_person"
            app:iconGravity="textStart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Egob.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_registry_support"
                android:textColor="@color/outline"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="•"
                android:textColor="@color/outline"
                android:textSize="11sp" />

            <TextView
                style="@style/TextAppearance.Egob.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_security_audits"
                android:textColor="@color/outline"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="•"
                android:textColor="@color/outline"
                android:textSize="11sp" />

            <TextView
                style="@style/TextAppearance.Egob.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_accessibility"
                android:textColor="@color/outline"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
