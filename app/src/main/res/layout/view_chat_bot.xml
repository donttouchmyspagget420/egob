<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_icon_primary"
        android:contentDescription="@string/assistant_bot"
        android:padding="7dp"
        android:src="@drawable/ic_ai"
        app:tint="@color/on_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chat_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_bot"
            android:maxWidth="300dp"
            android:paddingStart="13dp"
            android:paddingTop="10dp"
            android:paddingEnd="13dp"
            android:paddingBottom="10dp"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_action"
            style="@style/Widget.Egob.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/assistant_start_service"
            android:visibility="gone"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconSize="14dp" />
    </LinearLayout>
</LinearLayout>
